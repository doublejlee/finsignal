# Virtual environment
venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Environment variables (API keys later)
.env

# YouTube auth cookies — contains session tokens, never commit
cookies.txt

# Data files
data/

# Jupyter checkpoints
.ipynb_checkpoints/

# VS Code settings
.vscode/

# Model cache (HuggingFace downloads models here, large files)
.cache/

# graphify knowledge-graph artifacts (generated)
graphify-out/

# DuckDB write-ahead log (transient; checkpoints into the .duckdb file)
*.wal

# RAG embeddings — large (~50MB), regenerable local index; not deployed (see db/init.py)
db/embeddings.duckdb